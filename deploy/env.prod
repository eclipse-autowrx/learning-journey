# Production Environment Variables
# Copy this file to .env.prod and modify as needed

# Docker Image Configuration
DOCKER_IMAGE=ghcr.io/eclipse-autowrx/learning-journey:latest

# Database Configuration
# MongoDB connection URI (format: mongodb://username:password@host:port/database?authSource=admin)
# This is the ONLY required MongoDB configuration variable
# For containerized MongoDB, use 'mongodb' as the host (Docker service name)
# For external MongoDB, use the actual hostname/IP address
MONGO_URI=mongodb://admin:your_secure_password_here@mongodb:27017/learning_journey?authSource=admin

# Optional: MongoDB container initialization variables
# Only set these if you want different credentials than defaults (admin/password123/27000)
# These should match the username/password in your MONGO_URI:
# MONGO_USERNAME=admin
# MONGO_PASSWORD=your_secure_password_here
# MONGO_PORT=27000

# Application Configuration
NODE_ENV=production
APP_PORT=3090
NEXT_PUBLIC_BASE_URL=https://your-domain.com:3090
USER_BASE_URL=https://backend-core-dev.digital.auto/v2

# MongoDB Express (Admin UI)
MONGO_EXPRESS_USERNAME=admin
MONGO_EXPRESS_PASSWORD=your_admin_password_here
MONGO_EXPRESS_PORT=8081

# Media Configuration
THUMBNAIL_SIZE=300
MAX_IMG_SIZE=10000000

# Security (generate these for production)
JWT_SECRET=your_jwt_secret_here
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=https://your-domain.com:3090

# Optional: External MongoDB (if not using containerized MongoDB)
# MONGO_URI=mongodb://username:password@your-mongodb-host:27000/learning_journey?authSource=admin
