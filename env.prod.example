# Production Environment Variables
# Copy this file to .env.prod and modify as needed

# Database Configuration
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=your_secure_password_here
MONGO_PORT=27000

# Application Configuration
NODE_ENV=production
APP_PORT=3000

# MongoDB Express (Admin UI)
MONGO_EXPRESS_USERNAME=admin
MONGO_EXPRESS_PASSWORD=your_admin_password_here
MONGO_EXPRESS_PORT=8081

# Nginx Configuration
NGINX_PORT=80
NGINX_SSL_PORT=443

# Application URLs
NEXT_PUBLIC_API_URL=https://your-domain.com
NEXT_PUBLIC_APP_URL=https://your-domain.com

# Security (generate these for production)
JWT_SECRET=your_jwt_secret_here
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=https://your-domain.com

# Optional: External MongoDB (if not using containerized MongoDB)
# MONGO_URI=mongodb://username:password@your-mongodb-host:27000/learning_journey?authSource=admin
