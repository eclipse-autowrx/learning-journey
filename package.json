{
  "name": "learning-journey",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup:dev": "node scripts/setup-dev.js",
    "setup:prod": "node scripts/setup-prod.js",
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "migrate": "node scripts/migrate-data.js",
    "migrate-collections": "node scripts/migrate-collections.js",
    "clean-migrate": "node scripts/clean-and-migrate.js",
    "docker:dev:up": "docker compose -f docker-compose.dev.yml up -d",
    "docker:dev:down": "docker compose -f docker-compose.dev.yml down",
    "docker:dev:logs": "docker compose -f docker-compose.dev.yml logs -f",
    "docker:prod:up": "docker compose -f docker-compose.prod.yml --env-file .env.prod up -d",
    "docker:prod:down": "docker compose -f docker-compose.prod.yml --env-file .env.prod down",
    "docker:prod:logs": "docker compose -f docker-compose.prod.yml --env-file .env.prod logs -f",
    "docker:prod:admin": "docker compose -f docker-compose.prod.yml --env-file .env.prod --profile admin up -d",
    "docker:prod:nginx": "docker compose -f docker-compose.prod.yml --env-file .env.prod --profile nginx up -d",
    "docker:prod:full": "docker compose -f docker-compose.prod.yml --env-file .env.prod --profile admin --profile nginx up -d",
    "backup": "node scripts/backup-db.js",
    "backup:sh": "bash scripts/backup-db.sh",
    "restore": "node scripts/restore-db.js",
    "restore:sh": "bash scripts/restore-db.sh",
    "populate-lessons": "node scripts/populate-lesson-content.js",
    "populate-lessons:dry": "node scripts/populate-lesson-content.js --dry-run"
  },
  "dependencies": {
    "@ckeditor/ckeditor5-react": "^9.5.0",
    "@hello-pangea/dnd": "^18.0.1",
    "@monaco-editor/react": "^4.7.0",
    "@types/file-saver": "^2.0.7",
    "dayjs": "^1.11.13",
    "dotenv": "^16.6.1",
    "file-saver": "^2.0.5",
    "formidable": "^3.5.4",
    "jszip": "^3.10.1",
    "mongoose": "^8.14.1",
    "next": "15.3.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.5.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^15.6.1",
    "rehype-raw": "^7.0.0",
    "sharp": "^0.34.2",
    "sonner": "^2.0.7",
    "sweetalert2": "^11.22.3",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.16",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
